# Variables de entorno del proyecto (Punto 16).
# Este archivo se versiona: NO escribir credenciales reales aquí.

SPRING_PROFILES_ACTIVE=prod
PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/academic_events_db
DB_USERNAME=ups
DB_PASSWORD=cambiar

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=generar-una-clave-de-al-menos-384-bits
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=proyecto-api

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

SWAGGER_USER=evaluador
SWAGGER_PASSWORD=cambiar

JAVA_TOOL_OPTIONS=-Xmx300m -XX:MaxMetaspaceSize=128m